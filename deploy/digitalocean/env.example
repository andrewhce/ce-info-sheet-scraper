# Copy this file to ".env" inside deploy/digitalocean/ before running docker compose.
# Never commit the real ".env" file or share it publicly.

# --- 1. Hostname & HTTPS (required — no path or https:// prefix here) ---
# Example with company DNS A-record: schools.cardinaleducation.com
# Example with free DuckDNS subdomain: ce-school-sheet.duckdns.org
APP_DOMAIN=schools.cardinaleducation.com

# --- 2. Google Workspace Sign-In (required on a public server) ---
# Authorized redirect URI in Google Cloud Console must be:
#   https://YOUR_APP_DOMAIN/auth/callback
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Restrict login to company Google Workspace accounts (or add comma-separated ALLOWED_EMAILS)
ALLOWED_EMAIL_DOMAIN=cardinaleducation.com
ALLOWED_EMAILS=

# Optional 32+ char cookie signing secret (generate: openssl rand -base64 36).
# If left blank, the container creates one automatically inside persistent /data.
SESSION_SECRET=

# --- 3. Ask AI Assistant (Sonnet 5.5 + Medium effort stay cost-locked by default) ---
ANTHROPIC_API_KEY=sk-ant-replace-with-your-key
# Or leave the key out and name the person who may paste it into the Ask page's "AI settings" box (several emails: separate with commas)
ASK_ADMIN_EMAILS=
ASK_MONTHLY_CAP_USD=5
ASK_WEB_SEARCH=1

# --- 4. Scraper & Runtime Tuning ---
CRAWL_PARALLEL_SITES=8
# Set to 1 to install Chromium for JS-heavy SPA school pages (0 builds faster/smaller)
INSTALL_CHROMIUM=1
TZ=America/Los_Angeles
